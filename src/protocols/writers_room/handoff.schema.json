{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-system/protocols/writers_room/handoff.schema.json",
  "title": "writers_room Handoff Envelope",
  "description": "Single authoritative schema for every envelope dropped in handoff/ between the writers_room agent (Quartermaster) and an external advisory crew role. Discriminated union on `direction`. App-level, project-agnostic — see gemini_crew_handoff.md for the human-readable contract this schema enforces.",
  "type": "object",
  "required": ["direction", "source_ref"],
  "properties": {
    "direction": {
      "enum": [
        "QUARTERMASTER_TO_EDITOR",
        "EDITOR_TO_QUARTERMASTER",
        "QUARTERMASTER_TO_GRAMMATIZATOR",
        "GRAMMATIZATOR_TO_QUARTERMASTER",
        "QUARTERMASTER_TO_PROOFER",
        "PROOFER_TO_QUARTERMASTER"
      ]
    },
    "source_ref": { "type": "string" }
  },

  "$defs": {
    "ref_id": {
      "type": "string",
      "pattern": "^(WB-[0-9]{3}|CHAR-[a-z0-9-]+|PLOT-[a-z0-9-]+|VOICE-[0-9]{3})$"
    },
    "pointer": {
      "type": "object",
      "required": ["file"],
      "properties": {
        "id": { "$ref": "#/$defs/ref_id" },
        "file": { "type": "string" },
        "sections": { "type": "array", "items": { "type": "string" } },
        "read_for": { "type": "string" },
        "note": { "type": "string" },
        "excerpt": { "type": "string", "description": "Verbatim text of the named sections. Present only in delivery:embedded (for a no-access external agent); omitted in pointers mode." }
      },
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "required": ["content_rules"],
      "properties": {
        "content_rules": { "type": "string" },
        "invent_freely": { "type": "array", "items": { "type": "string" } },
        "do_not_touch": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "delta": {
      "type": "object",
      "required": ["n", "change"],
      "properties": {
        "n": { "type": "integer", "minimum": 1 },
        "affected_ids": { "type": "array", "items": { "$ref": "#/$defs/ref_id" } },
        "change": { "type": "string" }
      },
      "additionalProperties": false
    },
    "specimen": {
      "type": "object",
      "required": ["n", "candidate_ids", "strength", "recurrence"],
      "properties": {
        "n": { "type": "integer", "minimum": 1 },
        "candidate_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ref_id" } },
        "quote": { "type": "string" },
        "locator": { "type": "string" },
        "move": { "type": "string" },
        "pair": {
          "type": "object",
          "required": ["a", "b"],
          "properties": { "a": { "type": "string" }, "b": { "type": "string" } },
          "additionalProperties": false
        },
        "delta": { "type": "string" },
        "strength": { "enum": ["textbook", "clear", "weak"] },
        "recurrence": { "enum": ["pervasive", "several", "one-off"] }
      },
      "oneOf": [
        { "required": ["quote", "locator", "move"], "not": { "required": ["pair"] } },
        { "required": ["pair", "delta"], "not": { "required": ["quote"] } }
      ],
      "additionalProperties": false
    }
  },

  "oneOf": [
    {
      "title": "QUARTERMASTER_TO_EDITOR",
      "properties": {
        "direction": { "const": "QUARTERMASTER_TO_EDITOR" },
        "source_ref": {},
        "role_profile": { "const": "protocols/writers_room/crew_roles/editor.md" },
        "scope_intent": { "type": "string" },
        "delivery": { "enum": ["pointers", "embedded"], "default": "pointers", "description": "pointers (default): agent reads the pointed-to files itself. embedded: each reference_pack item carries its verbatim excerpt, for a no-local-access external agent." },
        "reference_pack": { "type": "array", "items": { "$ref": "#/$defs/pointer" } },
        "voice_profile": { "type": "array", "items": { "$ref": "#/$defs/pointer" } },
        "constraints": { "$ref": "#/$defs/constraints" },
        "open_questions": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["role_profile", "scope_intent", "reference_pack", "constraints"],
      "additionalProperties": false,
      "if": {
        "required": ["delivery"],
        "properties": { "delivery": { "const": "embedded" } }
      },
      "then": {
        "properties": {
          "reference_pack": { "items": { "required": ["excerpt"] } }
        }
      }
    },
    {
      "title": "EDITOR_TO_QUARTERMASTER",
      "properties": {
        "direction": { "const": "EDITOR_TO_QUARTERMASTER" },
        "source_ref": {},
        "deltas": { "type": "array", "items": { "$ref": "#/$defs/delta" } },
        "open_questions": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["deltas"],
      "additionalProperties": false
    },
    {
      "title": "QUARTERMASTER_TO_GRAMMATIZATOR",
      "properties": {
        "direction": { "const": "QUARTERMASTER_TO_GRAMMATIZATOR" },
        "source_ref": {},
        "role_profile": { "const": "protocols/writers_room/crew_roles/grammatizator.md" },
        "mode": { "enum": ["BULK_CORPUS", "TARGETED_SAMPLE"] },
        "corpus_type": { "type": "string" },
        "provenance": { "enum": ["own-corpus", "external"], "description": "own-corpus: samples from the author's own approved writing. external: outside genre/reference samples — provenance firewall applies (abstract method facts only, no verbatim specimens)." },
        "target_ids": { "type": "array", "items": { "type": "string" } },
        "still_empty": { "type": "array", "items": { "$ref": "#/$defs/ref_id" } },
        "sample_ref": { "type": "string" }
      },
      "required": ["mode", "corpus_type", "provenance", "sample_ref"],
      "additionalProperties": false
    },
    {
      "title": "GRAMMATIZATOR_TO_QUARTERMASTER",
      "properties": {
        "direction": { "const": "GRAMMATIZATOR_TO_QUARTERMASTER" },
        "source_ref": {},
        "mode": { "enum": ["BULK_CORPUS", "TARGETED_SAMPLE"] },
        "corpus_type": { "type": "string" },
        "provenance": { "enum": ["own-corpus", "external"] },
        "specimen_pack": { "type": "array", "items": { "$ref": "#/$defs/specimen" } },
        "none_found": { "type": "array", "items": { "$ref": "#/$defs/ref_id" } },
        "lexicon": {
          "type": "object",
          "properties": {
            "favored_verbs": { "type": "array", "items": { "type": "string" } },
            "avoided_or_absent": { "type": "array", "items": { "type": "string" } },
            "register_lean": { "type": "string" },
            "tics": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "count"],
                "properties": {
                  "name": { "type": "string" },
                  "quote": { "type": "string" },
                  "count": { "type": "integer", "minimum": 1 }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "scout_notes": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["mode", "corpus_type", "provenance"],
      "additionalProperties": false,
      "if": {
        "required": ["provenance"],
        "properties": { "provenance": { "const": "external" } }
      },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["specimen_pack"] },
            { "required": ["lexicon"] }
          ]
        }
      }
    },
    {
      "title": "QUARTERMASTER_TO_PROOFER",
      "description": "Reserved — Proofer role specced but not yet built (see crew_roles/proofer.md). Shape finalized when the role is built.",
      "properties": {
        "direction": { "const": "QUARTERMASTER_TO_PROOFER" },
        "source_ref": {},
        "role_profile": { "const": "protocols/writers_room/crew_roles/proofer.md" },
        "scope_intent": { "type": "string" },
        "delivery": { "enum": ["pointers", "embedded"], "default": "pointers" },
        "prose_ref": { "type": "array", "items": { "$ref": "#/$defs/pointer" } }
      },
      "required": ["role_profile", "prose_ref"],
      "additionalProperties": false
    },
    {
      "title": "PROOFER_TO_QUARTERMASTER",
      "description": "Reserved — comment-only return. Shape finalized when the role is built.",
      "properties": {
        "direction": { "const": "PROOFER_TO_QUARTERMASTER" },
        "source_ref": {},
        "notes": { "type": "array", "items": { "type": "string" } },
        "open_questions": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["notes"],
      "additionalProperties": false
    }
  ]
}
